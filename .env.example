# Copy to .env.local for development. Never commit real values.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Career Consultation

# --- Supabase (required) ----------------------------------------------------
# Project Settings → API. The publishable (anon) key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service_role) key — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- AI (optional; AI features are disabled without a key) ------------------
AI_ENABLED=true
# "openai" (default) or "gemini" (Google; free tier available, see docs/SETUP.md).
AI_PROVIDER=openai
GEMINI_API_KEY=
# Defaults to gemini-flash-latest.
GEMINI_MODEL=
OPENAI_API_KEY=
# Any current model that supports structured outputs via the Responses API.
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=45000
# Lets resource suggestions use OpenAI's web search tool for cited links.
AI_WEB_SEARCH=false
# USD per 1M tokens — used only for cost estimates in the usage dashboard.
AI_INPUT_PRICE_PER_MTOK=0.25
AI_OUTPUT_PRICE_PER_MTOK=2

# --- Email via Resend (optional; notifications are recorded but not sent without it)
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Consultations <hello@yourdomain.com>"
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# --- Cron (reminders + retention) ------------------------------------------
# Long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
